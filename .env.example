# Copy to .env and fill in. .env is gitignored; nothing secret lives in code.
# The pipeline defaults to the Claude API for the report + dashboard agents.

# --- Claude API (default agent backend) ---------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_TIMEOUT=30
CLAUDE_MAX_TOKENS=1500

# --- Agent backend selector ---------------------------------------------------
# "claude" (default), "local", or "kiro". Fallback order:
#   kiro (if kiro-cli is installed) -> Claude API (if key set) -> local model -> deterministic text.
AGENT_BACKEND=claude

# --- Kiro CLI headless backend (AGENT_BACKEND=kiro; uses Kiro credits) ---------
# Needs kiro-cli on PATH and a paid-plan API key (app.kiro.dev -> API Keys), or an
# existing `kiro-cli login`. Never commit the real key.
KIRO_API_KEY=
KIRO_CLI=kiro-cli
KIRO_MODEL=
KIRO_TIMEOUT=180

# --- Local model fallback (OpenAI-compatible, e.g. vLLM) -----------------------
FALLBACK_LLM_URL=http://127.0.0.1:8000/v1
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=
