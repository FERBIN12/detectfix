# Copy to .env and fill in. .env is gitignored; nothing secret lives in code.
# The pipeline defaults to the Claude API for the report + dashboard agents.

# --- Claude API (default agent backend) ---------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_TIMEOUT=30
CLAUDE_MAX_TOKENS=1500

# --- Agent backend selector ---------------------------------------------------
# "claude" (default) or "local". If claude is selected but no API key is set,
# the pipeline falls back to the local model, then to deterministic text.
AGENT_BACKEND=claude

# --- Local model fallback (OpenAI-compatible, e.g. vLLM) -----------------------
FALLBACK_LLM_URL=http://127.0.0.1:8000/v1
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=
