Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /TF1
    Splitter Ratio: 0.5
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 100
    Normal Cell Count: 0
    Line Style:
      Line Width: 0.03
      Value: Lines
    Color: 160; 160; 164
    Alpha: 0.5
    Plane: XY
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 2.0
    Update Interval: 0
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_link:
        Value: true
      gimbal_cam:
        Value: true
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Topic:
      Value: /odom
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Covariance:
      Value: false
    Keep: 1
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Shaft Length: 2.0
      Shaft Radius: 0.12
      Head Length: 0.6
      Head Radius: 0.3
  - Class: rviz_default_plugins/Path
    Name: Path
    Enabled: true
    Topic:
      Value: /path
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 0; 230; 255
    Line Style: Billboards
    Alpha: 1
    Line Width: 0.18
  - Class: rviz_default_plugins/Path
    Name: Mission
    Enabled: true
    Topic:
      Value: /mission
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Color: 255; 255; 255
    Line Style: Billboards
    Line Width: 0.06
    Alpha: 0.8
  - Class: rviz_default_plugins/MarkerArray
    Name: MissionMarkers
    Enabled: true
    Topic:
      Value: /mission/markers
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Namespaces: {}
  - Class: rviz_default_plugins/MarkerArray
    Name: Defects
    Enabled: true
    Topic:
      Value: /defects
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Namespaces: {}
  - Class: rviz_default_plugins/PointCloud2
    Name: Lidar
    Enabled: true
    Topic:
      Value: /lidar/points
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Style: Flat Squares
    Size (Pixels): 3
    Size (m): 0.05
    Alpha: 0.9
    Decay Time: 0
    Color Transformer: FlatColor
    Channel Name: intensity
    Use rainbow: true
    Invert Rainbow: false
    Color: 255; 255; 255
  - Class: rviz_default_plugins/PointCloud2
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Style: Flat Squares
    Size (Pixels): 3
    Size (m): 0.06
    Alpha: 0.55
    Decay Time: 0
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds:
      Value: false
      Min Value: -1.0
      Max Value: 10.0
  - Class: rviz_default_plugins/Image
    Name: CameraRGB
    Enabled: true
    Topic:
      Value: /camera/rgb
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Image
    Name: CameraThermal
    Enabled: true
    Topic:
      Value: /camera/thermal
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Distance: 28.0
      Pitch: 0.62
      Yaw: 3.6
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Height: 1050
  Width: 1900
  X: 0
  Y: 0
  Displays:
    collapsed: true
  Views:
    collapsed: true
  CameraRGB:
    collapsed: false
  CameraThermal:
    collapsed: false
